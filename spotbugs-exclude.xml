<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclude filter. Only narrow, documented exclusions — no category-wide rule is disabled:

  1. EI_EXPOSE_REP/EI_EXPOSE_REP2 on the internal raw-bytes HTTP response body ({@code
     ApiResponse}). Carrying the actual bytes rather than a defensive copy is the intended contract;
     the payload can be large (dataset exports, records ZIPs) and copying it on every access would be
     wasteful. {@code ApiResponse} is internal (not user-facing), just public because the resource
     clients that use it now live in sibling packages. The user-facing {@code KeyValueStoreRecord}
     value type does defensively copy its bytes. All other representation-exposure warnings are fixed
     in code (unmodifiable getters / copy-on-set) rather than excluded.

  2. EI_EXPOSE_REP2 on the resource clients that store a reference to the owning {@code ApifyClient}
     (needed to reach sibling resources, e.g. an Actor's build/run/version clients). {@code
     ApifyClient} is a genuinely immutable service handle - a `final` class with only `final` fields
     and no mutator methods - so storing the reference carries none of the aliasing risk the rule
     guards against; there is nothing to defensively copy for a service object.

  3. UWF_UNWRITTEN_FIELD / UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD on Jackson-populated DTOs/response
     shapes ({@code KeyValueStoreKey}, the internal error-response mapping in {@code
     HttpClientCore}): their fields are written by the deserializer via reflection, which SpotBugs
     cannot see - a known false positive for data-binding models.
-->
<FindBugsFilter>
  <Match>
    <Class name="com.apify.client.http.ApiResponse"/>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Or>
      <Class name="com.apify.client.actor.ActorClient"/>
      <Class name="com.apify.client.run.RunClient"/>
      <Class name="com.apify.client.task.TaskClient"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.apify.client.keyvalue.KeyValueStoreKey"/>
    <Bug pattern="UWF_UNWRITTEN_FIELD"/>
  </Match>
  <Match>
    <Class name="com.apify.client.http.HttpClientCore$ErrorBody"/>
    <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>
</FindBugsFilter>
